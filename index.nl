const fmtN=n=>n==null?'—':new Intl.NumberFormat('nl-NL').format(n);
function norm(s){return (s||'').normalize('NFD').replace(/[̀-ͯ]/g,'').toLowerCase().replace(/[^a-z0-9]/g,'')}
const ALIAS={'sgravenhage':'denhaag','hengeloo':'hengelo','bergennh':'bergen','bergennholland':'bergen','sudwestfryslan':'sudwestfryslan','nuenenca':'nuenengerwenenederwetten'};
const byKey=new Map(DATA.map(d=>[d.key,d]));
function getData(name){let k=norm(name); if(ALIAS[k])k=ALIAS[k]; let d=byKey.get(k); if(d)return d; // cautious fuzzy fallback
  const cand=DATA.filter(x=>x.key===k || x.key.startsWith(k) || k.startsWith(x.key)); return cand.length===1?cand[0]:null;}
const map=L.map('map',{zoomControl:true}).setView([52.18,5.35],7);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18,attribution:'© OpenStreetMap'}).addTo(map);
let mode='pc', geoLayer=null, featureLayers=[];
const pcBreaks=[5,8,10,12,15,20,30]; const pcCols=['#edf8fb','#ccece6','#99d8c9','#66c2a4','#41ae76','#238b45','#006d2c','#00441b'];
const tBreaks=[100000,200000,300000,500000,750000,1000000,2000000]; const tCols=['#f7fbff','#deebf7','#c6dbef','#9ecae1','#6baed6','#4292c6','#2171b5','#084594'];
function color(d){if(!d||d.uncertain||d.amount==null||(mode==='pc'&&d.percap==null))return '#c9ced3';let v=mode==='pc'?d.percap:d.amount,b=mode==='pc'?pcBreaks:tBreaks,c=mode==='pc'?pcCols:tCols;for(let i=0;i<b.length;i++)if(v<b[i])return c[i];return c[c.length-1];}
function propName(p){const keys=['gemeentenaam','GM_NAAM','statnaam','name','naam','gemeente','municipality'];for(const k of keys)if(p&&p[k])return p[k];for(const [k,v] of Object.entries(p||{}))if(typeof v==='string'&&/naam|name/i.test(k))return v;return '';}
function style(f){let d=getData(propName(f.properties));return {fillColor:color(d),weight:.7,color:'#fff',fillOpacity:.84}}
function popup(name,d){if(!d)return `<div class="popup"><h3>${name}</h3><div>Geen gekoppelde onderzoeksdata.</div></div>`;let w=d.note?`<div class="warn">${d.note}</div>`:'';return `<div class="popup"><h3>${name}</h3><table><tr><td>Microsoft 2025</td><td>${fmtE(d.amount)}</td></tr><tr><td>Inwoners 1-1-2026</td><td>${fmtN(d.population)}</td></tr><tr><td>Per inwoner</td><td>${fmt2(d.percap)}</td></tr></table>${w}</div>`}
function onEach(f,l){const name=propName(f.properties),d=getData(name);l.bindTooltip(name,{sticky:true});l.bindPopup(popup(name,d));l.on({mouseover:e=>e.target.setStyle({weight:2,color:'#333'}),mouseout:e=>geoLayer.resetStyle(e.target)});featureLayers.push({name:norm(name),layer:l,d})}
function renderRanking(){let a=DATA.filter(d=>mode==='pc'?d.percap!=null:(!d.uncertain&&d.amount!=null&&d.sourceName!=='Amstelveen (& Aalsmeer)')).sort((a,b)=>(mode==='pc'?b.percap-a.percap:b.amount-a.amount)).slice(0,15);document.getElementById('rankTitle').textContent=mode==='pc'?'Duurste per inwoner':'Hoogste totaalbedragen';document.getElementById('ranking').innerHTML=a.map((d,i)=>`<div class="rank" data-k="${d.key}"><span class="num">${i+1}</span><span>${d.name}</span><strong>${mode==='pc'?fmt2(d.percap):fmtE(d.amount)}</strong></div>`).join('');document.querySelectorAll('.rank').forEach(el=>el.onclick=()=>focus(el.dataset.k));}
function focus(k){let x=featureLayers.find(x=>x.d&&x.d.key===k)||featureLayers.find(x=>x.name===k);if(x){map.fitBounds(x.layer.getBounds(),{maxZoom:10,padding:[30,30]});x.layer.openPopup();}}
function restyle(){if(geoLayer)geoLayer.setStyle(style);renderRanking();}
document.getElementById('pc').onclick=()=>{mode='pc';pc.classList.add('active');tot.classList.remove('active');restyle()};document.getElementById('tot').onclick=()=>{mode='tot';tot.classList.add('active');pc.classList.remove('active');restyle()};
document.getElementById('reset').onclick=()=>map.setView([52.18,5.35],7);
document.getElementById('search').addEventListener('keydown',e=>{if(e.key==='Enter'){let q=norm(e.target.value);let x=featureLayers.find(x=>x.name.includes(q)||(x.d&&x.d.key.includes(q)));if(x)focus(x.d?x.d.key:x.name)}});
function legend(){let div=L.control({position:'bottomleft'});div.onAdd=()=>{let x=L.DomUtil.create('div','legend');x.innerHTML='<b>€ per inwoner</b><br>'+pcBreaks.map((b,i)=>`<span class="sw" style="background:${pcCols[i]}"></span>${i?pcBreaks[i-1]+'–':''}${b}<br>`).join('')+`<span class="sw" style="background:${pcCols.at(-1)}"></span>≥ ${pcBreaks.at(-1)}<br><span class="sw" style="background:#c9ced3"></span>onzeker / geen data`;return x};div.addTo(map)}
fetch(GEO).then(r=>{if(!r.ok)throw new Error('GeoJSON niet geladen');return r.json()}).then(g=>{geoLayer=L.geoJSON(g,{style,onEachFeature:onEach}).addTo(map);try{map.fitBounds(geoLayer.getBounds(),{padding:[8,8]})}catch(e){};renderRanking();legend();}).catch(e=>{let x=document.getElementById('err');x.style.display='block';x.innerHTML='<b>De gemeentegrenzen konden niet worden geladen.</b><br>Controleer de internetverbinding en open het bestand opnieuw. De kaart haalt alleen de openbare grensgeometrie online op.';renderRanking();});
</script></body></html>
